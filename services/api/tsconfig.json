{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@growthengine/shared": ["../../packages/shared/src/index.ts"]
    },
    "rootDir": "../../",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "checkJs": false
  },
  "include": [
    "src"
  ],
  "references": [
  { "path": "../../packages/shared" }
]
}
