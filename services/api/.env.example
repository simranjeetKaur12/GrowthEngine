# Shared
GITHUB_TOKEN=your_github_token_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_CLASSIFIER=gpt-4.1-mini
OPENAI_MODEL_EVALUATOR=gpt-4.1

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_SCHEMA=public

# Judge0
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_judge0_api_key_here

# API
PORT=4000
API_BASE_URL=http://localhost:4000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Feature Flags
AI_ANALYZER_ENABLED=true
ISSUE_EXECUTION_MODE=ai_only
JUDGE0_DISABLED_FOR_ISSUES=true
ISSUE_SIMULATION_USES_JUDGE0=false
GUIDED_CONTEXT_ENABLED=true
GUIDED_CONTEXT_USE_AI=true
MULTI_LAYER_EVALUATION_ENABLED=true
STRUCTURAL_EVALUATION_ENABLED=true
BEHAVIORAL_EVALUATION_ENABLED=false
